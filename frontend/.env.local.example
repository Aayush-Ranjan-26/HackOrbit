# ─── Supabase (required for sign-in) ─────────────────────────────────────────
# Settings → API. Copy this file to .env.local and fill it in there — do not
# edit this template. The anon key is public by design; never put the
# service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ─── CAPTCHA (optional) ──────────────────────────────────────────────────────
# Cloudflare Turnstile SITE key — public by design. Get it from
# dash.cloudflare.com → Turnstile → Add widget. The SECRET key never goes here:
# it goes only into Supabase → Authentication → Attack Protection.
# Set this and Supabase's CAPTCHA switch together — if Supabase requires CAPTCHA
# and this is blank, every email sign-in is rejected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Backend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8080

# ─── Admin (optional, server-side only) ──────────────────────────────────────
# Must match backend ADMIN_SECRET_KEY. Deliberately NOT NEXT_PUBLIC_ — it is read
# only by the /api/admin route handler and never reaches the browser.
ADMIN_SECRET_KEY=

# Supabase user ids allowed to reach /admin, comma-separated. Unset ⇒ admin is
# unreachable. Find yours in Supabase → Authentication → Users.
ADMIN_USER_IDS=

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Project settings → API. The service-role key bypasses RLS: server only, never
# expose it to the browser.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ─── Admin (optional) ────────────────────────────────────────────────────────
# Unset = /admin/* returns 503. There is no default: a shared default key is the
# same as no key. Generate one: openssl rand -hex 32
ADMIN_SECRET_KEY=

# Set to true ONLY when a reverse proxy really terminates requests in front of
# this server. Otherwise any caller can forge X-Forwarded-For to reset their
# own rate-limit bucket.
TRUST_PROXY=false

# ─── Scraper ─────────────────────────────────────────────────────────────────
# Run the 6-hourly cron in this process. Enable on exactly ONE instance, or leave
# false and drive POST /admin/scrape from an external scheduler.
ENABLE_CRON=false

# USD→INR used to normalise Devpost prizes for cross-source ranking. Tune as FX moves.
INR_PER_USD=88
